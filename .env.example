# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_KEEPALIVE_TIMEOUT_MS=20000

# MongoDB Configuration
# Get connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# Upstash Redis Configuration (Optional - for rate limiting)
# Get these from https://console.upstash.com/redis
# If not set, rate limiting will be disabled (fail-open)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Logging Configuration
# Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Sentry Configuration (Optional - for error tracking)
# Get these from https://sentry.io/settings/projects/your-project/keys/
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@o123456.ingest.sentry.io/1234567

# For source map uploads (CI/CD only)
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
